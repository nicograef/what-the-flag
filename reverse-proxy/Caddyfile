# The edge image (reverse-proxy/Dockerfile) bakes this file in, so a change ships with the next release.

# ── Redirect www to the apex domain ──
www.what-the-flag.de {
	redir https://what-the-flag.de{uri} permanent
}

# ── Primary site (HTTP redirects to HTTPS automatically) ──
what-the-flag.de {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The SPA loads only its own files and has no inline script or style, so neither source allows inline code.
		# Vite inlines assets under 4 KiB as data: URLs, images and fonts alike.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Caddy is the edge: it replaces a client-sent X-Forwarded-For with the real peer.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# >>> stack: frontend
	# The SPA build the edge image bakes into /srv.
	handle {
		root * /srv
		encode zstd gzip

		# Build output under /assets/ has content-hashed names, so a file never changes.
		# A missing one is a 404, never index.html, and `match` keeps a 404 out of caches.
		handle /assets/* {
			header {
				Cache-Control "public, max-age=31536000, immutable"
				match status 2xx 3xx
			}
			file_server
		}

		# Unhashed files from public/: the favicon, the flags and the Open Graph image.
		@public path *.png *.svg
		handle @public {
			header {
				Cache-Control "public, max-age=3600"
				match status 2xx 3xx
			}
			file_server
		}

		# Every route falls back to index.html; revalidating it lets a deploy reach clients at once.
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
	# <<< stack: frontend
}
