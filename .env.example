# Copy to .env and fill in real values.
#
# Every variable the tree reads stands here, and nothing else does: a documented
# variable no code reads is a lie.

# ── Compose (server only) ──
# Lets plain `docker compose` and scripts/backup-postgres.sh target the prod stack.
# COMPOSE_FILE=docker-compose.prod.yml

# ── Database ──
POSTGRES_USER=admin
# URL-safe characters only: the migrate service puts the password into a connection URL.
POSTGRES_PASSWORD=<your-db-password>
POSTGRES_DB=whattheflag
# Compose sets postgres in production; a backend on the host reaches the dev container here.
# DB_HOST=localhost

# ── Application ──
# APP_PORT=8080

# ── Monitoring ──
# Dead-man's switch, pinged by scripts/backup-postgres.sh after a verified backup. Setup: guides/monitoring.md.
# BACKUP_PING_URL=<your-ping-url>
