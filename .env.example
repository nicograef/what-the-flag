# Copy to .env and fill in real values.
#
# Every variable the tree reads stands here, and nothing else does: a documented
# variable no code reads is a lie.

# ── Compose (server only) ──
# Lets plain `docker compose` target the prod stack, as the handbook's deploy and backup guides expect.
# COMPOSE_FILE=docker-compose.prod.yml

# ── Database ──
POSTGRES_USER=admin
# URL-safe characters only: the migrate service puts the password into a connection URL.
POSTGRES_PASSWORD=<your-db-password>
POSTGRES_DB=whattheflag
# Every Compose service sets postgres itself; a backend on the host reaches the dev container here.
DB_HOST=localhost

# ── Monitoring ──
# Dead-man's switch, pinged by scripts/backup-postgres.sh after a verified backup. Setup: the handbook's guides/monitoring.md.
# BACKUP_PING_URL=<your-ping-url>
