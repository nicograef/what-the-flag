# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go – gofmt enforces tabs
[*.go]
indent_style = tab

# Makefile – tabs required by make
[Makefile]
indent_style = tab

# Caddyfile – tabs, as caddy fmt writes them
[{Caddyfile*,*.Caddyfile}]
indent_style = tab

# Markdown – trailing spaces can be intentional (line breaks)
[*.md]
trim_trailing_whitespace = false

# Upstream bytes: the importer copies data/LICENSE verbatim, and capitals.csv is CRLF as served
[{data/LICENSE,data/sources/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
